    <script>
    const AudioEngine = {
        ctx: null,
        bgmGain: null,
        sfxGain: null,
        bgmVolume: parseFloat(localStorage.getItem('restaurant_bgm_vol') ?? 0.5),
        sfxVolume: parseFloat(localStorage.getItem('restaurant_sfx_vol') ?? 0.7),
        bgmTimer: null,
        isBgmPlaying: false,

        init() {
            if (!this.ctx) {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                this.ctx = new AudioCtx();

                this.bgmGain = this.ctx.createGain();
                this.bgmGain.gain.value = this.bgmVolume;
                this.bgmGain.connect(this.ctx.destination);

                this.sfxGain = this.ctx.createGain();
                this.sfxGain.gain.value = this.sfxVolume;
                this.sfxGain.connect(this.ctx.destination);
            }
            if (this.ctx.state === 'suspended') {
                this.ctx.resume();
            }
        },

        setBgmVolume(val) {
            this.bgmVolume = val;
            localStorage.setItem('restaurant_bgm_vol', val);
            if (this.bgmGain) this.bgmGain.gain.value = val;
            if (val > 0 && !this.isBgmPlaying) this.startBGM();
        },

        setSfxVolume(val) {
            this.sfxVolume = val;
            localStorage.setItem('restaurant_sfx_vol', val);
            if (this.sfxGain) this.sfxGain.gain.value = val;
        },

        playCoin() {
            this.init(); if (!this.ctx) return;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(880, this.ctx.currentTime);
            osc.frequency.setValueAtTime(1200, this.ctx.currentTime + 0.08);
            gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.25);
            osc.connect(gain); gain.connect(this.sfxGain);
            osc.start(); osc.stop(this.ctx.currentTime + 0.25);
        },

        playCookSound() {
            this.init(); if (!this.ctx) return;
            const bufferSize = this.ctx.sampleRate * 0.3;
            const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
            const noise = this.ctx.createBufferSource();
            noise.buffer = buffer;
            const filter = this.ctx.createBiquadFilter();
            filter.type = 'bandpass'; filter.frequency.value = 1000;
            const gain = this.ctx.createGain();
            gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);
            noise.connect(filter); filter.connect(gain); gain.connect(this.sfxGain);
            noise.start();
        },

        playBell() {
            this.init(); if (!this.ctx) return;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(987.77, this.ctx.currentTime);
            gain.gain.setValueAtTime(0.25, this.ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.6);
            osc.connect(gain); gain.connect(this.sfxGain);
            osc.start(); osc.stop(this.ctx.currentTime + 0.6);
        },

        playFanfare() {
            this.init(); if (!this.ctx) return;
            const notes = [261.63, 329.63, 392.00, 523.25, 659.25, 783.99];
            notes.forEach((freq, idx) => {
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(freq, this.ctx.currentTime + idx * 0.08);
                gain.gain.setValueAtTime(0.3, this.ctx.currentTime + idx * 0.08);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + idx * 0.08 + 0.3);
                osc.connect(gain); gain.connect(this.sfxGain);
                osc.start(this.ctx.currentTime + idx * 0.08);
                osc.stop(this.ctx.currentTime + idx * 0.08 + 0.3);
            });
        },

        startBGM() {
            this.init();
            if (this.isBgmPlaying) return;
            this.isBgmPlaying = true;

            const melodyNotes = [
                261.63, 329.63, 392.00, 329.63,
                293.66, 349.23, 440.00, 349.23,
                329.63, 392.00, 523.25, 392.00,
                349.23, 440.00, 392.00, 293.66
            ];
            let noteIdx = 0;

            const playNextNote = () => {
                if (!this.isBgmPlaying) return;
                if (this.bgmVolume > 0 && this.ctx) {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(melodyNotes[noteIdx], this.ctx.currentTime);
                    
                    gain.gain.setValueAtTime(0.08, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.45);

                    osc.connect(gain);
                    gain.connect(this.bgmGain);

                    osc.start();
                    osc.stop(this.ctx.currentTime + 0.45);
