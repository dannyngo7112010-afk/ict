<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nhà Hàng Gia Đình - Cozy Cartoon Edition</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Phaser 3 CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/phaser/3.60.0/phaser.min.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Comfortaa & Quicksand -->
    <link href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@500;700&family=Quicksand:wght@600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        cozy: ['Quicksand', 'Comfortaa', 'sans-serif'],
                    },
                    colors: {
                        cream: '#FFF8F0',
                        warmBrown: '#6e472a',
                        pastelOrange: '#FFB085',
                        pastelYellow: '#FFD97D',
                        pastelGreen: '#95DAC1',
                        pastelPink: '#FFC6C7',
                        softDark: '#3A3335',
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Quicksand', sans-serif;
            background-color: #F7EBE1;
            color: #3A3335;
            touch-action: manipulation;
            user-select: none;
        }

        .cartoon-box {
            background-color: #FFF8F0;
            border: 3px solid #523826;
            box-shadow: 4px 4px 0px #523826;
            border-radius: 1.25rem;
        }

        .cartoon-btn {
            border: 3px solid #422a1b;
            box-shadow: 3px 3px 0px #422a1b;
            transition: all 0.1s ease-in-out;
            font-weight: 700;
        }

        .cartoon-btn:hover {
            transform: translate(-1px, -1px);
            box-shadow: 4px 4px 0px #422a1b;
        }

        .cartoon-btn:active {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0px #422a1b;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #FFEAD7;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #FFB085;
            border: 2px solid #523826;
            border-radius: 10px;
        }

        .modal-backdrop {
            background-color: rgba(68, 52, 40, 0.75);
            backdrop-filter: blur(4px);
        }

        #konami-toast {
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
    </style>
</head>
