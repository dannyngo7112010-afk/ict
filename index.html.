    function cookPanDish() {
        if (state.panSlots.length === 0) return;

        AudioEngine.playCookSound();

        let cogs = 0;
        const usedCounts = {};
        state.panSlots.forEach(s => {
            const ing = GAME_DATA.ingredients.find(i => i.id === s.id);
            cogs += ing.cost;
            usedCounts[s.id] = (usedCounts[s.id] || 0) + 1;
        });
        state.cogsDay += cogs;

        let matchedRecipe = null;
        GAME_DATA.recipes.forEach(rec => {
            if (rec.method === state.selectedMethod) {
                const reqKeys = Object.keys(rec.reqs);
                const panKeys = Object.keys(usedCounts);
                if (reqKeys.length === panKeys.length && reqKeys.every(k => rec.reqs[k] === usedCounts[k])) {
                    matchedRecipe = rec;
                }
            }
        });

        state.panSlots = [];

        let finalDish = {
            name: 'Món Thử Nghiệm',
            price: 12,
            quality: 'low',
            comment: 'Món ăn lạ vị...'
        };

        if (matchedRecipe) {
            finalDish = {
                id: matchedRecipe.id,
                name: matchedRecipe.name,
                price: matchedRecipe.price,
                quality: 'high',
                comment: 'Tuyệt ngon chuẩn vị!'
            };

            const stateRec = state.knownRecipes.find(r => r.id === matchedRecipe.id);
            if (stateRec && !stateRec.discovered) {
                stateRec.discovered = true;
                if (!state.menu.includes(stateRec.id)) state.menu.push(stateRec.id);
                if (gameScene) gameScene.showFloatingText(400, 150, `✨ SÁNG TẠO SỚM: ${matchedRecipe.name}!`, '#D97706');
            }
        }

        serveToCustomer(finalDish);
        updateSidebarUI();
    }

    function serveToCustomer(dish) {
        let targetTable = state.tables.find(t => t.occupied && (t.customer.orderId === dish.id || t.customer.orderId === 'SURPRISE'));

        if (!targetTable) {
            targetTable = state.tables.find(t => t.occupied);
        }

        if (targetTable) {
            const cust = targetTable.customer;
            AudioEngine.playBell();

            let earned = dish.price;
            let tip = Math.round(earned * 0.2 * cust.data.tipMult);

            if (dish.quality === 'low') {
                earned = Math.round(earned * 0.5);
                tip = 0;
            }

            state.gold += (earned + tip);
            state.revenueDay += earned;
            state.tipsDay += tip;

            if (gameScene) {
                gameScene.showFloatingText(targetTable.x, targetTable.y, `+${earned + tip} xu! (${dish.comment})`, '#059669');
                gameScene.removeCustomerGraphic(cust);
            }

            targetTable.occupied = false;
            targetTable.customer = null;
        } else {
            state.wasteDay += dish.price;
            if (gameScene) gameScene.showFloatingText(400, 150, `Bỏ món phí phạm! (-${dish.price}xu)`, '#E11D48');
        }
    }

