        state.phase = 'SERVICE';
        currentHour = 8;
        updateSidebarUI();

        clockInterval = setInterval(() => {
            currentHour++;
            const displayTime = currentHour < 12 ? `${currentHour}:00 AM` : `${currentHour === 12 ? 12 : currentHour - 12}:00 PM`;
            document.getElementById('clock-time').innerText = displayTime;

            if (currentHour >= 17) {
                endServicePhase();
            }
        }, 3000);

        customerSpawnInterval = setInterval(() => {
            spawnCustomer();
        }, 4000);
    }

    function spawnCustomer() {
        const freeTable = state.tables.find(t => !t.occupied);
        if (!freeTable) return;

        const custType = GAME_DATA.customerTypes[Math.floor(Math.random() * GAME_DATA.customerTypes.length)];
        let chosenDishId = state.menu[Math.floor(Math.random() * state.menu.length)];
        let chosenDishName = GAME_DATA.recipes.find(r => r.id === chosenDishId)?.name || 'Cơm Chiên Trứng';

        if (Math.random() < 0.2) {
            chosenDishId = 'SURPRISE';
            chosenDishName = '🎁 Món Bất Ngờ';
        }

        const customer = {
            data: custType,
            orderId: chosenDishId,
            orderName: chosenDishName,
            maxPatience: custType.patience,
            currentPatience: custType.patience
        };

        freeTable.occupied = true;
        freeTable.customer = customer;

        if (gameScene) {
            gameScene.spawnCustomerGraphic(freeTable, customer);
        }

        updateSidebarUI();
    }

    function endServicePhase() {
        clearInterval(clockInterval);
        clearInterval(customerSpawnInterval);

        const hasFridge = state.upgrades.find(u => u.id === 'fridge')?.bought;
        if (!hasFridge) {
            Object.keys(state.inventory).forEach(id => {
                const count = state.inventory[id];
                if (count > 0) {
                    const ing = GAME_DATA.ingredients.find(i => i.id === id);
                    state.wasteDay += (count * ing.cost);
                }
            });
            state.inventory = {};
        }

        state.phase = 'SUMMARY';
        showSummaryModal();
    }

    function showSummaryModal() {
        const grossIncome = state.revenueDay + state.tipsDay;

        document.getElementById('sum-revenue').innerText = `+${state.revenueDay} xu`;
        document.getElementById('sum-tips').innerText = `+${state.tipsDay} xu`;
        document.getElementById('sum-gross').innerText = `+${grossIncome} xu`;
        document.getElementById('sum-cogs').innerText = `-${state.cogsDay} xu`;
        document.getElementById('sum-opex').innerText = `-${state.opexDay} xu`;
        document.getElementById('sum-target-val').innerText = `${state.targetProfit} xu`;

        const statusDiv = document.getElementById('summary-status');
        const actionBtn = document.getElementById('btn-summary-action');

        if (grossIncome >= state.targetProfit) {
            statusDiv.className = "p-3 rounded-xl text-center text-xs font-bold mb-4 bg-emerald-500/20 text-emerald-700 border-2 border-emerald-600";
            statusDiv.innerText = `🎉 XUẤT SẮC! ĐẠT CHỈ TIÊU THU NHẬP (${grossIncome}/${state.targetProfit} XU)`;
            actionBtn.innerText = "Sang Ngày Tiếp Theo 🚀";
            actionBtn.onclick = () => advanceNextDay();
        } else {
            statusDiv.className = "p-3 rounded-xl text-center text-xs font-bold mb-4 bg-rose-500/20 text-rose-700 border-2 border-rose-600";
            statusDiv.innerText = `❌ CHƯA ĐẠT CHỈ TIÊU (${grossIncome}/${state.targetProfit} XU). CHƠI LẠI NGÀY NÀY!`;
            actionBtn.innerText = "Thử Lại Ngày Này 🔄";
            actionBtn.onclick = () => retryDay();
        }

        document.getElementById('modal-summary').classList.remove('hidden');
    }

    function advanceNextDay() {
        document.getElementById('modal-summary').classList.add('hidden');
        state.day++;
        state.startDayGold = state.gold;
        resetDayStats();
        state.phase = 'MORNING';
        updateSidebarUI();
    }

    function retryDay() {
        document.getElementById('modal-summary').classList.add('hidden');
        state.gold = state.startDayGold;
        resetDayStats();
        state.phase = 'MORNING';
        updateSidebarUI();
    }

    function resetDayStats() {
        state.revenueDay = 0;
        state.tipsDay = 0;
        state.cogsDay = 0;
        state.wasteDay = 0;
        state.tables.forEach(t => {
            if (t.customer && gameScene) gameScene.removeCustomerGraphic(t.customer);
            t.occupied = false;
            t.customer = null;
        });
    }

    function renderRecipeBook() {
        const list = document.getElementById('recipes-list');
        let html = '';

        state.knownRecipes.forEach(r => {
            const methodObj = GAME_DATA.methods.find(m => m.id === r.method);
            let ingredientsText = '';
            let rawCostSum = 0;
            Object.keys(r.reqs).forEach(ingId => {
                const ing = GAME_DATA.ingredients.find(i => i.id === ingId);
                const qty = r.reqs[ingId];
                rawCostSum += (ing.cost * qty);
                ingredientsText += `<span class="px-2 py-0.5 bg-[#FFF8F0] border border-[#523826]/30 rounded-lg text-[11px] font-bold text-[#523826]">${ing.icon} ${ing.name} x${qty}</span> `;
            });

            const profit = r.price - rawCostSum;

            html += `
                <div class="bg-[#FFEAD7] p-4 rounded-2xl border-3 border-[#523826] flex flex-col justify-between shadow-sm">
                    <div>
                        <div class="flex items-center justify-between border-b-2 border-[#523826]/20 pb-2 mb-2">
                            <div class="flex items-center gap-2">
                                <span class="text-3xl">${r.discovered ? r.icon : '❓'}</span>
                                <div>
                                    <h4 class="font-bold text-sm text-[#523826]">${r.discovered ? r.name : '??? (Món Chưa Mở)'}</h4>
                                    <span class="text-[10px] font-bold text-[#D97706] bg-[#FFF8F0] px-2 py-0.5 rounded-full border border-[#523826]/20">
                                        ${methodObj.icon} ${methodObj.name}
                                    </span>
                                </div>
                            </div>
                            ${r.discovered ? `<span class="text-xs font-bold text-[#059669] bg-emerald-100 px-2 py-1 rounded-lg border border-emerald-400">Giá: ${r.price}xu</span>` : ''}
                        </div>

                        <div class="mt-2">
                            <div class="text-[11px] font-bold text-[#7A5B47] mb-1">CÔNG THỨC & NGUYÊN LIỆU:</div>
                            <div class="flex flex-wrap gap-1">
                                ${r.discovered ? ingredientsText : `<span class="text-xs text-[#7A5B47] italic">Tự động mở khóa vào <b>Ngày ${r.unlockDay}</b> (Hoặc tự sáng tạo thử nghiệm ngay hôm nay!)</span>`}
                            </div>
                        </div>
                    </div>

                    ${r.discovered ? `
                        <div class="mt-3 pt-2 border-t border-[#523826]/20 flex justify-between text-[11px] font-bold text-[#7A5B47]">
                            <span>Chi phí vốn: ${rawCostSum}xu</span>
                            <span class="text-[#059669]">Lợi nhuận: +${profit}xu</span>
                        </div>
                    ` : ''}
                </div>
            `;
        });

        list.innerHTML = html;
    }

    function renderShop() {
        const list = document.getElementById('shop-list');
        let html = '';
        state.upgrades.forEach(u => {
            html += `
                <div class="p-3 bg-[#FFEAD7] rounded-2xl border-2 border-[#523826] flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="text-3xl">${u.icon}</span>
                        <div>
                            <h4 class="font-bold text-sm text-[#523826]">${u.name}</h4>
                            <p class="text-xs text-[#7A5B47]">${u.desc}</p>
                        </div>
                    </div>
                    ${u.bought ? `
                        <span class="px-3 py-1 bg-gray-200 text-gray-600 text-xs font-bold rounded-xl border border-gray-400">Đã Có</span>
                    ` : `
                        <button onclick="buyUpgrade('${u.id}')" class="px-3 py-1.5 bg-[#FFD97D] hover:bg-[#f0c865] text-[#523826] cartoon-btn rounded-xl text-xs font-bold">
                            ${u.cost} xu
                        </button>
                    `}
                </div>
            `;
        });
        list.innerHTML = html;
    }

    function buyUpgrade(id) {
        const up = state.upgrades.find(u => u.id === id);
        if (up && !up.bought && state.gold >= up.cost) {
            state.gold -= up.cost;
            up.bought = true;

            if (id === 'tables' && state.tables.length < 3) {
                state.tables.push({ id: 3, occupied: false, customer: null, x: 640, y: 340 });
                if (gameScene) gameScene.renderTablesGraphics();
            }

            AudioEngine.playCoin();
            renderShop();
            updateSidebarUI();
        }
    }

    const konamiCode = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let konamiIndex = 0;

    window.addEventListener('keydown', (e) => {
        const key = e.key;
        const requiredKey = konamiCode[konamiIndex];

        if (key.toLowerCase() === requiredKey.toLowerCase()) {
            konamiIndex++;
            if (konamiIndex === konamiCode.length) {
                activateKonamiCheat();
                konamiIndex = 0;
            }
        } else {
            konamiIndex = 0;
        }
    });

    function activateKonamiCheat() {
        state.gold += 99999;
        AudioEngine.playFanfare();
        updateSidebarUI();

        const toast = document.getElementById('konami-toast');
        toast.classList.remove('opacity-0', 'scale-75', '-translate-y-10');
        toast.classList.add('opacity-100', 'scale-100', 'translate-y-0');

        if (gameScene) {
            gameScene.showFloatingText(400, 200, '🐔 PHÚC LÀNH THẦN KHÔ GÀ! 🐔', '#D97706');
        }

        setTimeout(() => {
            toast.classList.remove('opacity-100', 'scale-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'scale-75', '-translate-y-10');
        }, 3500);
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.body.addEventListener('click', () => {
            AudioEngine.init();
            AudioEngine.startBGM();
        }, { once: true });

        const bgmSlider = document.getElementById('slider-bgm');
        const sfxSlider = document.getElementById('slider-sfx');

        bgmSlider.value = AudioEngine.bgmVolume;
        sfxSlider.value = AudioEngine.sfxVolume;
        document.getElementById('bgm-val-text').innerText = `${Math.round(AudioEngine.bgmVolume * 100)}%`;
        document.getElementById('sfx-val-text').innerText = `${Math.round(AudioEngine.sfxVolume * 100)}%`;

        bgmSlider.addEventListener('input', (e) => {
            const val = parseFloat(e.target.value);
            AudioEngine.setBgmVolume(val);
            document.getElementById('bgm-val-text').innerText = `${Math.round(val * 100)}%`;
        });

        sfxSlider.addEventListener('input', (e) => {
            const val = parseFloat(e.target.value);
            AudioEngine.setSfxVolume(val);
            document.getElementById('sfx-val-text').innerText = `${Math.round(val * 100)}%`;
        });

        document.getElementById('btn-settings').addEventListener('click', () => {
            document.getElementById('modal-settings').classList.remove('hidden');
        });

        document.getElementById('btn-recipe-book').addEventListener('click', () => {
            renderRecipeBook();
            document.getElementById('modal-recipes').classList.remove('hidden');
        });

        document.getElementById('btn-open-shop').addEventListener('click', () => {
            renderShop();
            document.getElementById('modal-shop').classList.remove('hidden');
        });

        document.getElementById('btn-tutorial').addEventListener('click', () => {
            document.getElementById('modal-tutorial').classList.remove('hidden');
        });

        document.querySelectorAll('.btn-close-modal').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('modal-recipes').classList.add('hidden');
                document.getElementById('modal-shop').classList.add('hidden');
                document.getElementById('modal-settings').classList.add('hidden');
            });
        });

        document.getElementById('btn-close-tutorial').addEventListener('click', () => {
            document.getElementById('modal-tutorial').classList.add('hidden');
        });

        document.getElementById('modal-tutorial').classList.remove('hidden');

        updateSidebarUI();
    });
    </script>
</body>
</html>
